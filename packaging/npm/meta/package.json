{
  "name": "@keton-id/cora",
  "version": "0.0.0-template",
  "description": "Zero-knowledge secret injection runtime for AI agents. The cr CLI never lets an agent process see secret values — only names; values are decrypted in service memory and injected directly into subprocess env.",
  "type": "module",
  "bin": {
    "cr": "bin/cr.js"
  },
  "files": [
    "bin/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keton-id/cora.git"
  },
  "homepage": "https://cora.keton.id",
  "bugs": {
    "url": "https://github.com/keton-id/cora/issues"
  },
  "keywords": [
    "secret",
    "credential",
    "agent",
    "ai",
    "encryption",
    "zig",
    "vault",
    "env",
    "argon2",
    "xchacha20"
  ],
  "optionalDependencies": {
    "@keton-id/cora-darwin-x64": "0.0.0-template",
    "@keton-id/cora-darwin-arm64": "0.0.0-template",
    "@keton-id/cora-linux-x64": "0.0.0-template",
    "@keton-id/cora-linux-arm64": "0.0.0-template",
    "@keton-id/cora-win32-x64": "0.0.0-template",
    "@keton-id/cora-win32-arm64": "0.0.0-template"
  }
}
