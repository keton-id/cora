  "bugs": {
    "url": "https://github.com/keton-id/cora/issues"
  },
  "keywords": [
    "secret",
    "credential",
    "agent",
    "ai",
    "encryption",
    "zig",
    "vault",
    "env",
    "argon2",
    "xchacha20"
  ],
